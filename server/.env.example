# DCmon agent / realtime env sample
DCMON_RPC_URL=https://rpc.example
DCMON_TOKEN_ADDR=0xYourDCmonToken
DCMON_HOUSE_TREASURY=0xHouseWallet
DCMON_PLAYER_REWARD_POOL=0xRewardPool
DCMON_OPERATOR_PK=0xabc123privatekey
DCMON_PAYMASTER_ADDR=0xPaymaster
DCMON_PAYMASTER_MIN=0.25
DCMON_PAYMASTER_TARGET=0.75
DCMON_REWARD_INTERVAL_MS=900000
DCMON_PAYMASTER_INTERVAL_MS=300000
DCMON_LOG_DIR=./artifacts/dcmon-agent
DCMON_SWAP_QUEUE=./artifacts/dcmon-agent/queue.json
DCMON_LOG_ENC_KEY=owner-wallet-secret
DCMON_DRY_RUN=true
DCMON_LOG_LEVEL=info
