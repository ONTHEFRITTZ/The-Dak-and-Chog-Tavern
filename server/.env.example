# DCmon agent / realtime env sample
DCMON_RPC_URL=https://rpc.example
DCMON_TOKEN_ADDR=0xYourDCmonToken
DCMON_WMON_ADDR=0xWrappedMonad
DCMON_POOL_ADDR=0xBankrollPool
DCMON_HOUSE_TREASURY=0xHouseWallet
DCMON_PLAYER_REWARD_POOL=0xRewardPool
DCMON_OPERATOR_PK=0xabc123privatekey
DCMON_OPERATOR_KEEP_NATIVE=0.05

# Paymaster automation
DCMON_PAYMASTER_ADDR=0xPaymaster
DCMON_PAYMASTER_MIN=0.25
DCMON_PAYMASTER_TARGET=0.75
DCMON_PAYMASTER_CHUNK=0
DCMON_PAYMASTER_INTERVAL_MS=300000

# Pool liquidity automation
DCMON_POOL_MIN_DCMON=0
DCMON_POOL_TARGET_DCMON=1500
DCMON_POOL_MIN_UNDERLYING=25
DCMON_POOL_TARGET_UNDERLYING=50
DCMON_POOL_INTERVAL_MS=600000

# Reward harvesting
DCMON_REWARD_MIN=10
DCMON_REWARD_TARGET=50
DCMON_REWARD_KEEP_WMON=5
DCMON_REWARD_INTERVAL_MS=900000

# Swap queue processing cadence
DCMON_SWAP_INTERVAL_MS=60000

# Execution tuning
DCMON_WRAP_MAX_CHUNK=100
DCMON_NATIVE_GAS_LIMIT=0
DCMON_APPROVE_MAX=true

# Storage / logging
DCMON_LOG_DIR=./artifacts/dcmon-agent
DCMON_SWAP_QUEUE=./artifacts/dcmon-agent/queue.json
DCMON_LOG_ENC_KEY=owner-wallet-secret
DCMON_DRY_RUN=true
DCMON_LOG_LEVEL=info
